&pinctrl {
 uart0_default: uart0_default {
  group1 {
   psels = <((((((0) * 32U) + (25)) & 0x1FFU) << 0U) | ((0U & 0xFFU) << 24U))>,
    <((((((0) * 32U) + (24)) & 0x1FFU) << 0U) | ((1U & 0xFFU) << 24U))>;
  };
 };

 uart0_sleep: uart0_sleep {
  group1 {
   psels = <((((((0) * 32U) + (25)) & 0x1FFU) << 0U) | ((0U & 0xFFU) << 24U))>,
    <((((((0) * 32U) + (24)) & 0x1FFU) << 0U) | ((1U & 0xFFU) << 24U))>;
   low-power-enable;
  };
 };

 i2c2_default: i2c2_default {
  group1 {
   psels = <((((((0) * 32U) + (1)) & 0x1FFU) << 0U) | ((12U & 0xFFU) << 24U))>,
    <((((((0) * 32U) + (2)) & 0x1FFU) << 0U) | ((11U & 0xFFU) << 24U))>;
  };
 };

 i2c2_sleep: i2c2_sleep {
  group1 {
   psels = <((((((0) * 32U) + (1)) & 0x1FFU) << 0U) | ((12U & 0xFFU) << 24U))>,
    <((((((0) * 32U) + (2)) & 0x1FFU) << 0U) | ((11U & 0xFFU) << 24U))>;
   low-power-enable;
  };
 };

 spi1_default: spi1_default {
  group1 {
   psels = <((((((0) * 32U) + (7)) & 0x1FFU) << 0U) | ((7U & 0xFFU) << 24U))>,
    <((((((0) * 32U) + (8)) & 0x1FFU) << 0U) | ((8U & 0xFFU) << 24U))>,
    <((((((0) * 32U) + (9)) & 0x1FFU) << 0U) | ((9U & 0xFFU) << 24U))>,
    <((((((0) * 32U) + (10)) & 0x1FFU) << 0U) | ((10U & 0xFFU) << 24U))>;
  };
 };

 spi1_sleep: spi1_sleep {
  group1 {
   psels = <((((((0) * 32U) + (7)) & 0x1FFU) << 0U) | ((7U & 0xFFU) << 24U))>,
    <((((((0) * 32U) + (8)) & 0x1FFU) << 0U) | ((8U & 0xFFU) << 24U))>,
    <((((((0) * 32U) + (9)) & 0x1FFU) << 0U) | ((9U & 0xFFU) << 24U))>,
    <((((((0) * 32U) + (10)) & 0x1FFU) << 0U) | ((10U & 0xFFU) << 24U))>;
   low-power-enable;
  };
 };

 spi3_default: spi3_default {
  group1 {
   psels = <((((((0) * 32U) + (29)) & 0x1FFU) << 0U) | ((4U & 0xFFU) << 24U))>,
    <((((((0) * 32U) + (27)) & 0x1FFU) << 0U) | ((6U & 0xFFU) << 24U))>,
    <((((((0) * 32U) + (28)) & 0x1FFU) << 0U) | ((5U & 0xFFU) << 24U))>;
   nordic,drive-mode = <3U>;
  };
 };

 spi3_sleep: spi3_sleep {
  group1 {
   psels = <((((((0) * 32U) + (29)) & 0x1FFU) << 0U) | ((4U & 0xFFU) << 24U))>,
    <((((((0) * 32U) + (27)) & 0x1FFU) << 0U) | ((6U & 0xFFU) << 24U))>,
    <((((((0) * 32U) + (28)) & 0x1FFU) << 0U) | ((5U & 0xFFU) << 24U))>;
   low-power-enable;
  };
 };
};
# 7 "/home/ashuqullah-alizai/Documents/DECT_2020_GIT/HS_DECT_SHELL/boards/debut_module/debut_module_nrf9151_common.dtsi" 2


/ {
 model = "DEBUT DECT NR+ Module";
 compatible = "phytec,debut-module";

 chosen {
  zephyr,console = &uart0;
  zephyr,shell-uart = &uart0;
  zephyr,uart-mcumgr = &uart0;
 };

 leds {
  compatible = "gpio-leds";

  led_red: led_0 {
   gpios = <&gpio0 21 (0 << 0)>;
   label = "Red LED 1";
  };

  led_green: led_1 {
   gpios = <&gpio0 22 (0 << 0)>;
   label = "Green LED 2";
  };

  led_blue: led_2 {
   gpios = <&gpio0 23 (0 << 0)>;
   label = "Blue LED 3";
  };
 };


 aliases {
  led0 = &led_red;
  led1 = &led_green;
  led2 = &led_blue;
  bootloader-led0 = &led_blue;
  mcuboot-led0 = &led_blue;
  watchdog0 = &wdt0;
 };

 i2c_address_pins {
  compatible = "gpio-keys";

  lpin: lpin {
   gpios = <&gpio0 31 (0 << 0)>;
  };
  hpin: hpin {
   gpios = <&gpio0 30 (0 << 0)>;
  };
 };
};

&gpiote {
 status = "okay";
};

&gpio0 {
 status = "okay";
};

&uart0 {
 status = "okay";
 current-speed = <115200>;
 pinctrl-0 = <&uart0_default>;
 pinctrl-1 = <&uart0_sleep>;
 pinctrl-names = "default", "sleep";
};

&i2c2 {
 compatible = "nordic,nrf-twim";
 status = "okay";
 pinctrl-0 = <&i2c2_default>;
 pinctrl-1 = <&i2c2_sleep>;
 pinctrl-names = "default", "sleep";
 clock-frequency = <400000>;
};

&spi1 {
 compatible = "nordic,nrf-spis";
 status = "okay";
 pinctrl-0 = <&spi1_default>;
 pinctrl-1 = <&spi1_sleep>;
 pinctrl-names = "default", "sleep";

 def-char = <0x00>;
};


&spi3 {
 compatible = "nordic,nrf-spim";
 status = "okay";
 cs-gpios = <&gpio0 26 (1 << 0)>;
 pinctrl-0 = <&spi3_default>;
 pinctrl-1 = <&spi3_sleep>;
 pinctrl-names = "default", "sleep";

 w25q16: w25q16jvsniq@1 {
  compatible = "jedec,spi-nor";
  status = "okay";
  reg = <1>;
  spi-max-frequency = <133000000>;
  jedec-id = [ef 40 15];
  size = <0x200000>;
  has-dpd;
  t-enter-dpd = <3000>;
  t-exit-dpd = <40000>;
 };
};


